# ═══════════════════════════════════════════════════════════════════════════
#  NFI Report — template .env.local
#
#  Copier vers .env.local puis remplir les valeurs.
#  Alternative rapide : `vercel env pull .env.local --environment=production`
#  si tu es membre du projet Vercel.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nfireport.com

# ─── Supabase (Auth + Database) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Resend (emails transactionnels) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ─── iPayMoney (paiements Mobile Money & carte bancaire) ────────────────────
# Public key : exposée au navigateur via le SDK checkout.js
NEXT_PUBLIC_IPAYMONEY_PUBLIC_KEY=your_ipaymoney_public_key
# Secret partagé pour authentifier les callbacks webhook iPayMoney.
# Configurer côté iPayMoney/Ifutur le même secret dans les paramètres webhook.
# Accepté via header X-Webhook-Secret, Authorization: Bearer, ou body field webhook_secret.
# OBLIGATOIRE en production, sinon tous les callbacks sont rejetés (sécurité C-1).
# Générer avec : openssl rand -hex 32
IPAYMONEY_WEBHOOK_SECRET=your_ipaymoney_webhook_secret

# Signing secret Svix natif pour les webhooks Resend (RECOMMANDÉ).
# Format attendu : whsec_BASE64SECRET (donné par Resend dashboard > Webhooks > Signing Secret).
# Le code vérifie la signature avec anti-replay 5 min. Si présent, prioritaire sur le legacy.
RESEND_WEBHOOK_SIGNING_SECRET=whsec_your_resend_signing_secret

# Legacy shared secret (fallback transition, à retirer après migration Svix complète).
# Accepté via header X-Webhook-Secret ou Authorization: Bearer. PLUS via ?secret= URL (H-3 fix).
# Générer avec : openssl rand -hex 32
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# ─── Sentry (monitoring erreurs) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# ─── PostHog (analytics produit) ────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sécurité cron + revalidation ISR ───────────────────────────────────────
# Générer avec : openssl rand -hex 32
CRON_SECRET=your_cron_secret
REVALIDATE_SECRET=your_revalidation_secret
