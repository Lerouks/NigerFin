msgid "https://wordpress.org/plugins/ipaymoney-woocommerce-plugin"
msgstr "https://wordpress.org/plugins/ipaymoney-woocommerce-plugin"

#. Description of the plugin/theme
msgid ""
"iPaymoney allows businesses to safely receive payments by mobile money, credit "
"card and bank account."
msgstr ""
"iPaymoney permet aux entreprises de recevoir des paiements par mobile money, "
"carte de crédit et compte bancaire en toute sécurité."

