{
  "crons": [
    {
      "path": "/api/cron/expire-subscriptions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/expiration-warning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reset-market-close",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/update-market-data",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-scheduled-newsletters",
      "schedule": "0 7 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
